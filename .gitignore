# ==============================================================================
# 🐾 DovahScribe — Comprehensive Whitelist .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caches & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.ruff_cache/
.pytest_cache/

# ------------------------------------------------------------------------------
# 2. Environment Files, Secrets & Local Settings
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
settings.json
TODO.md
TODO*.md
*_TODO.md
*.log
logs/

# ------------------------------------------------------------------------------
# 3. OS & IDE Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ------------------------------------------------------------------------------
# 4. Third-Party Binary Assets & External Tools
# ------------------------------------------------------------------------------
Assets/
Interface/

# ------------------------------------------------------------------------------
# 5. DATA DIRECTORY: Strict Whitelist (Block ALL except Core Dictionaries)
# ------------------------------------------------------------------------------
# Block everything inside data/ by default (reviews, patches, tm, raw caches, mcm outputs):
data/*

# Whitelist: ALLOW ONLY canonical TES dictionaries & immutable glossaries
!data/Strings/
!data/Strings/**
!data/global_glossary.json
!data/false_friends.json
!data/vanilla_dictionary.json

# ------------------------------------------------------------------------------
# 6. WEB DIRECTORY: Strict Whitelist (Block generated mod dashboards)
# ------------------------------------------------------------------------------
# Block generated per-mod dashboard HTML files & backup images
web/*_dashboard.html
web/*_backup.*

# Whitelist: ALLOW Master Template & Brand Banner
!web/cat_dashboard.html
!web/dovahscribe_banner.jpg

# ------------------------------------------------------------------------------
# 7. SCRATCH & TEMPORARY FILES (Diagnostic dumps, one-off scripts, test plugins)
# ------------------------------------------------------------------------------
scratch/
scratch/**
*.tmp
*.bak
*.swp
*.patch
*.diff

# ------------------------------------------------------------------------------
# 8. SCRIPTS: Root & Source temporary one-off scratch scripts
# ------------------------------------------------------------------------------
translate_*.py
!translate.py
src/apply_*.py
src/translate_*.py
