# === DovahScribe Environment Configuration ===
# Скопируйте этот файл в .env и укажите ваши настройки

# 🔑 API ключи для AI-агента (Gemini / OpenAI / OpenRouter)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# 📁 Пути к Mod Organizer 2 (для автоматического поиска BSA и деплоя модов)
# Пример: D:/Games/Skyrim SE/MO2 или C:/Users/Username/AppData/Local/ModOrganizer/SkyrimSE
MO2_BASE_PATH=
MO2_ACTIVE_PROFILE=

# 🌐 Языковые настройки по умолчанию
DEFAULT_SOURCE_LANG=EN
DEFAULT_TARGET_LANG=RU

# ⚙️ Настройки интерфейса DovahScribe
DOVAHSCRIBE_PORT=42001
DOVAHSCRIBE_DEBUG=false
