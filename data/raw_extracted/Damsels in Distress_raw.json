    "editorid": "damsel0_QuestRescue_LunaBranch01Topic",
    "path": "Name",
    "text": "Are you alright?",
    "parent_context": {}
  },
  {
    "formid": "000908:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_LunaBranch01b",
    "path": "Name",
    "text": "Yes. Let's get you to safety.",
    "parent_context": {}
  },
  {
    "formid": "00090A:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_LunaBranch02Topic",
    "path": "Name",
    "text": "How did you end up here?",
    "parent_context": {}
  },
  {
    "formid": "00090C:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_LunaBranch02b",
    "path": "Name",
    "text": "You can stay with me if you like.",
    "parent_context": {}
  },
  {
    "formid": "00090E:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_LunaBranch02c",
    "path": "Name",
    "text": "I'm sorry to hear that.",
    "parent_context": {}
  },
  {
    "formid": "000910:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_LunaBranch03Topic",
    "path": "Name",
    "text": "You'll be safe here.",
    "parent_context": {}
  },
  {
    "formid": "000916:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_AmberBranch01Topic",
    "path": "Name",
    "text": "Are you alright?",
    "parent_context": {}
  },
  {
    "formid": "000918:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_AmberBranch01b",
    "path": "Name",
    "text": "Yes. I'm real and the Falmer are gone.",
    "parent_context": {}
  },
  {
    "formid": "00091A:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_AmberBranch01c",
    "path": "Name",
    "text": "We need to go, it's not safe here.",
    "parent_context": {}
  },
  {
    "formid": "00091C:Damsels in Distress.esp",
    "type": "DialogTopic",
    "editorid": "damsel0_QuestRescue_AmberBranch02Topic",
